{
  "name": "p1xel-lab",
  "version": "1.0.0",
  "description": "P1xel Lab — a modding-first Minecraft launcher by VividP1xels",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "VividP1xels",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "peerjs": "^1.5.5"
  },
  "productName": "P1xel Lab",
  "build": {
    "appId": "com.vividp1xels.p1xellab",
    "productName": "P1xel Lab",
    "icon": "renderer/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "P1xel-Lab-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "portable": {
      "artifactName": "P1xel-Lab-Portable.${ext}"
    }
  }
}